# Required credentials and PostgreSQL connection (fill locally).
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
ARCADE_API_KEY=
# Supabase Session pooler (port 5432) or direct PostgreSQL URL; append ?ssl=require.
DATABASE_URL=
# Optional local Docker only; unused when DATABASE_URL points to Supabase.
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=
# Required Arcade client identification, e.g. application name and contact.
ARCADE_USER_AGENT=
# Optional; blank uses the defaults documented in README.md.
# Defaults to gpt-5.6-luna when blank.
OPENAI_MODEL=
ARCADE_BASE_URL=
# Maximum latest messages analyzed when Core is @mentioned (default 100).
LORE_WINDOW_SIZE=
VOTE_DURATION_SECONDS=
ARCADE_POLL_SECONDS=
ARCADE_JOB_TIMEOUT_SECONDS=
